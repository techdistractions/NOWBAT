# Create INPUT.TXT before running this sample.
EXISTS "INPUT.TXT"
IF %RESULT% NE 0 THEN GOTO MISSING
COPY "INPUT.TXT" "OUTPUT.TXT"
IF %RESULT% NE 0 THEN GOTO FAILED
LOGFILE "COPY.LOG"
LOG "INPUT.TXT copied to OUTPUT.TXT"
LOGCLOSE
END
:MISSING
LOGFILE "COPY.LOG"
LOG "INPUT.TXT is missing"
LOGCLOSE
END
:FAILED
LOGFILE "COPY.LOG"
LOG "Copy failed"
LOGCLOSE
END
