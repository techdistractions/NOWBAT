# Run CAPTURE.WAS in a writable current directory.
# Opens a 5 second window to arrange the desktop.
ShowIcon=YES
WAIT 5000
SNAP "SCREEN.BMP"
IF %RESULT% NE 0 THEN GOTO ERROR
TARCREATE "SCREEN.TAR"
IF %RESULT% NE 0 THEN GOTO ERROR
TARADD "SCREEN.BMP"
IF %RESULT% NE 0 THEN GOTO ERROR
TARCLOSE
IF %RESULT% NE 0 THEN GOTO ERROR
END
:ERROR
LOGFILE "CAPERR.LOG"
LOG "Capture or TAR creation failed"
LOGCLOSE
END
