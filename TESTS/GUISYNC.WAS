; NOWBAT W066 GUISYNC native witness: HEADLESS DOEVENTS + WAITFOR FILE.
; Launcher replaces C:\WASUAT with the scratch guest folder and @RUN@ with token.
; Closed marker files and authentic interpreter END are required for PASS.
SHOWICON=NO
DOEVENTS
IF %RESULT% NE 0 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
LOGFILE "C:\WASUAT\GSEVENT.OK"
LOG "EVENT_OK=@RUN@"
LOGCLOSE
WAITFOR FILE "C:\WASUAT\GSEVENT.OK" TIMEOUT 1000
IF %RESULT% NE 0 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
LOGFILE "C:\WASUAT\GSFOUND.OK"
LOG "FILE_FOUND=@RUN@"
LOGCLOSE
; The absent marker is never created by this script; each staging slot is fresh.
LOGFILE "C:\WASUAT\GSMBEG.OK"
LOG "TIMEOUT_BEGIN=@RUN@"
LOGCLOSE
WAITFOR FILE "C:\WASUAT\GSMISS.OK" TIMEOUT 700
IF %RESULT% NE 1 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
LOGFILE "C:\WASUAT\GSMDON.OK"
LOG "TIMEOUT_DONE=@RUN@"
LOGCLOSE
DOEVENTS
IF %RESULT% NE 0 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
LOGFILE "C:\WASUAT\GSTIME.LOG"
LOG "GUEST_COMPLETED=%DATE% %TIME%"
LOGCLOSE
LOGFILE "C:\WASUAT\GSPASS.OK"
LOG "SYNC_PASS=@RUN@"
LOGCLOSE
; Do not shut down Windows; host closes only this disposable DOSBox-X guest
; after detecting both the closed, token-matched PASS file and native END.
END
:ERROR
LOGFILE "C:\WASUAT\GSFAIL.LOG"
LOG "SYNC_FAIL=@RUN@ RESULT=%RESULT% ERRORCODE=%ERRORCODE%"
LOGCLOSE
FAIL
