; Native mouse events: independent WGEOM WndProc logs dispatch.
SHOWICON=NO
LOGFILE "C:\WASUAT\INPUT.LOG"
SET STAGE=START
SHELL "WGEOM.EXE"
IF %RESULT% NE 0 THEN GOTO ERROR
WAITFOR FILE "WGEOM.DAT" TIMEOUT 15000
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=FOCUS
WINDOWFOCUS "NOWBAT Geometry Fixture"
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=LEFT_MOVE
MOUSEMOVE REL,12,12
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=LEFT_CLICK
MOUSECLICK LEFT
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 500
SET STAGE=LEFT_WITNESS
WAITFOR FILE "WEVENT.DAT" TIMEOUT 5000
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=CLICK_SNAP
SNAP "C:\WASUAT\CLICK.BMP"
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=RIGHT_MOVE
MOUSEMOVE REL,25,25
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=RIGHT_CLICK
MOUSECLICK RIGHT
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 500
SET STAGE=DRAG_START
MOUSEMOVE REL,15,15
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=DRAG_DOWN
MOUSEDOWN LEFT
IF %RESULT% NE 0 THEN GOTO ERROR
IF %MOUSEHELD% NE 1 THEN GOTO ERROR
WAIT 200
SET STAGE=DRAG_MOVE
MOUSEMOVE REL,45,35
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=DRAG_UP
MOUSEUP LEFT
IF %RESULT% NE 0 THEN GOTO ERROR
IF %MOUSEHELD% NE 0 THEN GOTO ERROR
WAIT 500
SET STAGE=DRAG_SNAP
SNAP "C:\WASUAT\DRAG.BMP"
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=DOUBLE_MOVE
MOUSEMOVE REL,35,15
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=DOUBLE_CLICK
MOUSEDBLCLICK LEFT
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 500
SET STAGE=RELEASE_DOWN
MOUSEDOWN RIGHT
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=RELEASE
RELEASEINPUT
IF %RESULT% NE 0 THEN GOTO ERROR
IF %MOUSEHELD% NE 0 THEN GOTO ERROR
SET STAGE=INVALID
MOUSECLICK INVALID
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
LOG "Native input commands completed at %TIME%"
LOGCLOSE
LOGFILE "C:\WASUAT\INPASS.OK"
LOG "INPUT_PASS=@RUN@"
LOGCLOSE
END
:ERROR
SET FAILR=%RESULT%
SET FAILE=%ERRORCODE%
RELEASEINPUT
LOG "INPUT FAIL stage=%STAGE% result=%FAILR% error=%FAILE%"
LOGCLOSE
LOGFILE "C:\WASUAT\INFAIL.LOG"
LOG "INPUT_FAIL=@RUN@ STAGE=%STAGE% RESULT=%FAILR% ERRORCODE=%FAILE%"
LOGCLOSE
FAIL
