# WAS 0.0.1 headless smoke fixture - UAT\ must pre-exist on drive C:
SET OUT=C:\UAT
LOGFILE "%OUT%\WAS.LOG"
LOG "Starting WAS UAT"
CHDIR "C:\DOS"
SHELLWAIT "C:\DOS\COMMAND.COM" "/C VER"
IF %ERRORCODE% NE 0 GOTO FAILED
SNAPSAFE "%OUT%\SCREEN.BMP", 0,0,319,199,4
IF %RESULT% NE 0 GOTO FAILED
GOSUB COLLECT
IF %RESULT% NE 0 GOTO FAILED
LOG "UAT PASS"
PASS
:COLLECT
TARCREATE "%OUT%\RESULT.TAR"
TARADD "%OUT%\WAS.LOG"
TARADD "%OUT%\SCREEN.BMP"
TARCLOSE
RETURN
:FAILED
LOG "UAT FAILED"
FAIL
