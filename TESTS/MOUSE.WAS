; W069 native absolute cursor readback. Keep guest mouse untouched.
SHOWICON=NO
MOUSEMOVE 40,50
IF %RESULT% NE 0 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
DOEVENTS
IF %MOUSEX% NE 40 THEN GOTO ERROR
IF %MOUSEY% NE 50 THEN GOTO ERROR
LOGFILE "C:\WASUAT\MSFIRST.OK"
LOG "FIRST=@RUN@ %MOUSEX%,%MOUSEY%"
LOGCLOSE
SET X=120
SET Y=100
MOUSEMOVE %X%,%Y%
IF %RESULT% NE 0 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
DOEVENTS
IF %MOUSEX% NE 120 THEN GOTO ERROR
IF %MOUSEY% NE 100 THEN GOTO ERROR
LOGFILE "C:\WASUAT\MSSECOND.OK"
LOG "SECOND=@RUN@ %MOUSEX%,%MOUSEY%"
LOGCLOSE
MOUSEMOVE 65535,100
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
IF %MOUSEX% NE 120 THEN GOTO ERROR
IF %MOUSEY% NE 100 THEN GOTO ERROR
LOGFILE "C:\WASUAT\MSBAD.OK"
LOG "INVALID=@RUN@"
LOGCLOSE
LOGFILE "C:\WASUAT\MSPASS.OK"
LOG "MOUSE_PASS=@RUN@"
LOGCLOSE
END
:ERROR
SET FAILR=%RESULT%
SET FAILE=%ERRORCODE%
LOGFILE "C:\WASUAT\MSFAIL.LOG"
LOG "MOUSE_FAIL=@RUN@ RESULT=%FAILR% ERRORCODE=%FAILE% X=%MOUSEX% Y=%MOUSEY%"
LOGCLOSE
FAIL
