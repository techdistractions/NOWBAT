# W041 native command matrix: every result is checked by independent host files.
# Run via AUTOUAT, not through standard AUDIT. The host substitutes C:\WASUAT.
# Keep DOS 8.3 basenames and never touch the user's Windows installation.
# Disk-based GOTO/GOSUB scans from BOF, so keep labels CLOSE to BOF.
# The first jump skips the subroutines until they are called explicitly.
GOTO AUTO_MAIN
:SUB_ONE
LOG "SUB_ONE=@RUN@"
GOSUB SUB_TWO
RETURN
:SUB_TWO
LOG "SUB_TWO=@RUN@"
RETURN
:ERROR
LOGFILE "C:\WASUAT\ERROR.LOG"
LOG "AUTO_ERROR=@RUN@"
LOGCLOSE
SHUTDOWN

:AUTO_MAIN
LOG "DEFAULT_LOG=@RUN@"
LOGFILE "C:\WASUAT\START.OK"
LOG "AUTO_START=@RUN@"
LOGCLOSE
ShowIcon=YES
ASSERT %RESULT% EQ 0
# Capture environment values in a separate closed file BEFORE opening
# AUTO.LOG. LOGFILE replaces an existing file: reopening AUTO.LOG later
# would erase previously passed checkpoints.
SET WINVER=99
SET SCREENW=0
SET DISKFREE(C)=0
LOGFILE "C:\WASUAT\ENV.LOG"
LOG "WINVER=%WINVER%"
LOG "SCREENW=%SCREENW%"
LOG "SCREENH=%SCREENH%"
LOG "BPP=%BPP%"
LOG "DISKFREE(C)=%DISKFREE(C)%"
LOGCLOSE
LOGFILE "C:\WASUAT\AUTO.LOG"
LOG "AUTO_BEGIN=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPBEG.OK"
ASSERT %RESULT% EQ 0
SET KEY=ALPHA
SET KEY=BRAVO
IF %KEY% EQ ALPHA THEN GOTO ERROR
IF %KEY% NE BRAVO THEN GOTO ERROR
IF %KEY% = BRAVO THEN GOTO VAR_GOOD
GOTO ERROR
:VAR_GOOD
IF %KEY% <> ALPHA THEN GOSUB SUB_ONE
IF %RESULT% NE 0 THEN GOTO ERROR
LOG "CONTROL_OK=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPCTL.OK"
ASSERT %RESULT% EQ 0
IF %WINVER% EQ 99 THEN GOTO ERROR
IF %WINVER% EQ 0 THEN GOTO ERROR
IF %SCREENW% EQ 0 THEN GOTO ERROR
IF %SCREENH% EQ 0 THEN GOTO ERROR
IF %BPP% EQ 0 THEN GOTO ERROR
IF %DISKFREE(C)% EQ 0 THEN GOTO ERROR
LOG "ENV_OK=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPENV.OK"
ASSERT %RESULT% EQ 0
# W052: exercise SHELLWAIT in isolation first. The previous test launched
# WCHILD asynchronously and then launched WWAIT before either module was
# necessarily unloaded, producing nondeterministic module-usage results.
# This checks that the child has run AND its module has finished unloading.
SHELLWAIT "WWAIT.EXE" "ALPHA BETA" GAMMA
ASSERT %RESULT% EQ 0
ASSERT %ERRORCODE% EQ 0
EXISTS "WWAIT.OK"
ASSERT %RESULT% EQ 0
# Now separately exercise fire-and-forget SHELL. The marker is created by
# WCHILD after yielding; do not run another child module while it is active.
SHELL "WCHILD.EXE"
ASSERT %RESULT% EQ 0
COPY "TEST.WAS" "C:\WASUAT\LAUNCH.OK"
ASSERT %RESULT% EQ 0
WAIT 3000
ASSERT %RESULT% EQ 0
EXISTS "WCHILD.OK"
IF %RESULT% NE 0 THEN GOTO ERROR
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\ASYNC.OK"
ASSERT %RESULT% EQ 0
SHELL "NOAPP.EXE"
ASSERT %RESULT% NE 0
ASSERT %ERRORCODE% NE 0
SHELLWAIT "NOAPP.EXE"
ASSERT %RESULT% NE 0
ASSERT %ERRORCODE% NE 0
LOG "SHELL_OK=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPSHL.OK"
ASSERT %RESULT% EQ 0

MKDIR "C:\WASUAT\FS"
ASSERT %RESULT% EQ 0
MD "C:\WASUAT\FS\ONE"
ASSERT %RESULT% EQ 0
MKDIR "C:\WASUAT\FS\TWO"
ASSERT %RESULT% EQ 0
COPY "TEST.WAS" "C:\WASUAT\FS\A.TXT"
ASSERT %RESULT% EQ 0
EXISTS "C:\WASUAT\FS\A.TXT"
ASSERT %RESULT% EQ 0
REN "C:\WASUAT\FS\A.TXT" "C:\WASUAT\FS\B.TXT"
ASSERT %RESULT% EQ 0
RENAME "C:\WASUAT\FS\B.TXT" "C:\WASUAT\FS\C.TXT"
ASSERT %RESULT% EQ 0
MOVE "C:\WASUAT\FS\C.TXT" "C:\WASUAT\FS\D.TXT"
ASSERT %RESULT% EQ 0
COPY "C:\WASUAT\FS\D.TXT" "C:\WASUAT\FS\E.TXT"
ASSERT %RESULT% EQ 0
COPY "C:\WASUAT\FS\D.TXT" "C:\WASUAT\FS\F.TXT"
ASSERT %RESULT% EQ 0
COPY "C:\WASUAT\FS\D.TXT" "C:\WASUAT\FS\G.TXT"
ASSERT %RESULT% EQ 0
DEL "C:\WASUAT\FS\E.TXT"
ASSERT %RESULT% EQ 0
DELETE "C:\WASUAT\FS\F.TXT"
ASSERT %RESULT% EQ 0
ERASE "C:\WASUAT\FS\G.TXT"
ASSERT %RESULT% EQ 0
EXISTS "C:\WASUAT\FS\E.TXT"
ASSERT %RESULT% NE 0
COPY "C:\WASUAT\FS\ABSENT.X" "C:\WASUAT\FS\BAD.TXT"
ASSERT %RESULT% NE 0
ASSERT %ERRORCODE% NE 0
COPY "C:\WASUAT\FS\D.TXT" "C:\WASUAT\FS\D.TXT"
ASSERT %RESULT% NE 0
CHDIR "C:\WASUAT\FS"
ASSERT %RESULT% EQ 0
PWD
ASSERT %RESULT% EQ 0
CD "C:\WASUAT"
ASSERT %RESULT% EQ 0
DIR "C:\WASUAT\FS\*.TXT"
ASSERT %RESULT% EQ 0
RD "C:\WASUAT\FS\ONE"
ASSERT %RESULT% EQ 0
RMDIR "C:\WASUAT\FS\TWO"
ASSERT %RESULT% EQ 0
RMDIR "C:\WASUAT\FS"
ASSERT %RESULT% NE 0
LOG "FILES_OK=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPFIL.OK"
ASSERT %RESULT% EQ 0
WAIT 0
ASSERT %RESULT% EQ 0
WAIT 100
ASSERT %RESULT% EQ 0
LOG "WAIT_OK=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPWAT.OK"
ASSERT %RESULT% EQ 0
SNAPSAFE "C:\WASUAT\R1.BMP",0,0,15,15,1
ASSERT %RESULT% EQ 0
SNAPSAFE "C:\WASUAT\R4.BMP",0,0,15,15,4
ASSERT %RESULT% EQ 0
SNAPSAFE "C:\WASUAT\R8.BMP",0,0,15,15,8
ASSERT %RESULT% EQ 0
SNAPSAFE "C:\WASUAT\R24.BMP",0,0,15,15,24
ASSERT %RESULT% EQ 0
LOG "SNAP_OK=@RUN@"
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPSNP.OK"
ASSERT %RESULT% EQ 0
LOGCLOSE
TARCREATE "C:\WASUAT\AUTO.TAR"
ASSERT %RESULT% EQ 0
TARADD "C:\WASUAT\AUTO.LOG"
ASSERT %RESULT% EQ 0
TARADD "C:\WASUAT\FS\*.TXT"
ASSERT %RESULT% EQ 0
TARADD "C:\WASUAT\R4.BMP"
ASSERT %RESULT% EQ 0
TARCLOSE
ASSERT %RESULT% EQ 0
COPY "C:\WASUAT\ENV.LOG" "C:\WASUAT\CPTAR.OK"
ASSERT %RESULT% EQ 0
# Isolated terminal-command UAT. Each lives in its own directory and distinct
# linked module; their EARLY.LOG files cannot truncate the parent's trace.
LOGFILE "C:\WASUAT\TEND.BEG"
LOG "TERM_BEGIN_TEND=@RUN@"
LOGCLOSE
CHDIR "C:\WASUAT\TEND"
ASSERT %RESULT% EQ 0
SHELLWAIT "C:\WASUAT\TEND\NBTEND.EXE" "TEND.WAS"
ASSERT %RESULT% EQ 0
LOGFILE "C:\WASUAT\TEND.DON"
LOG "TERM_DONE_TEND=@RUN@"
LOGCLOSE
EXISTS "TERMEND.LOG"
ASSERT %RESULT% EQ 0
LOGFILE "C:\WASUAT\TPASS.BEG"
LOG "TERM_BEGIN_TPASS=@RUN@"
LOGCLOSE
CHDIR "C:\WASUAT\TPASS"
ASSERT %RESULT% EQ 0
SHELLWAIT "C:\WASUAT\TPASS\NBTPASS.EXE" "TPASS.WAS"
ASSERT %RESULT% EQ 0
LOGFILE "C:\WASUAT\TPASS.DON"
LOG "TERM_DONE_TPASS=@RUN@"
LOGCLOSE
EXISTS "TERMPASS.LOG"
ASSERT %RESULT% EQ 0
LOGFILE "C:\WASUAT\TFAIL.BEG"
LOG "TERM_BEGIN_TFAIL=@RUN@"
LOGCLOSE
CHDIR "C:\WASUAT\TFAIL"
ASSERT %RESULT% EQ 0
SHELLWAIT "C:\WASUAT\TFAIL\NBTFAIL.EXE" "TFAIL.WAS"
ASSERT %RESULT% EQ 0
LOGFILE "C:\WASUAT\TFAIL.DON"
LOG "TERM_DONE_TFAIL=@RUN@"
LOGCLOSE
EXISTS "TERMFAIL.LOG"
ASSERT %RESULT% EQ 0
LOGFILE "C:\WASUAT\DONE.LOG"
LOG "AUTO_DONE=@RUN@"
LOGCLOSE
ShowIcon=NO
ASSERT %RESULT% EQ 0
SHUTDOWN
