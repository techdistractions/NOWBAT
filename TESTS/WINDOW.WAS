; Native independent window fixture and client-relative USER readback.
SHOWICON=NO
SHELL "WGEOM.EXE"
IF %RESULT% NE 0 THEN GOTO ERROR
WAITFOR WINDOW "NOWBAT Geometry Fixture" TIMEOUT 15000
IF %RESULT% NE 0 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
IF %WINW% EQ 65535 THEN GOTO ERROR
LOGFILE "C:\WASUAT\WFIND.OK"
LOG "WINDOW_FOUND=@RUN@ %WINX%,%WINY%,%WINW%,%WINH%"
LOGCLOSE
WAITFOR FILE "WGEOM.DAT" TIMEOUT 15000
IF %RESULT% NE 0 THEN GOTO ERROR
DOEVENTS
WINDOWSELECT "NOWBAT Geometry Fixture"
IF %RESULT% NE 0 THEN GOTO ERROR
IF %WINW% EQ 65535 THEN GOTO ERROR
IF %WINH% EQ 65535 THEN GOTO ERROR
IF %WINW% EQ 0 THEN GOTO ERROR
IF %WINH% EQ 0 THEN GOTO ERROR
MOUSEMOVE REL,10,10
IF %RESULT% NE 0 THEN GOTO ERROR
LOGFILE "C:\WASUAT\WINGEO.OK"
LOG "GEOMETRY=@RUN@ %WINX%,%WINY%,%WINW%,%WINH% %MOUSEX%,%MOUSEY%"
LOGCLOSE
MOUSEMOVE REL,32767,32767
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
LOGFILE "C:\WASUAT\WINBAD.OK"
LOG "INVALID=@RUN@ %MOUSEX%,%MOUSEY%"
LOGCLOSE
LOGFILE "C:\WASUAT\WFBEG.OK"
LOG "WINDOW_TIMEOUT_BEGIN=@RUN@"
LOGCLOSE
WAITFOR WINDOW "NOWBAT W077 deliberately nonexistent window" TIMEOUT 1000
IF %RESULT% NE 1 THEN GOTO ERROR
IF %ERRORCODE% NE 0 THEN GOTO ERROR
IF %WINW% NE 65535 THEN GOTO ERROR
LOGFILE "C:\WASUAT\WFDONE.OK"
LOG "WINDOW_TIMEOUT_DONE=@RUN@"
LOGCLOSE
WAITFOR WINDOW "NOWBAT Geometry Fixture" TIMEOUT 0
IF %RESULT% NE 0 THEN GOTO ERROR
WAITFOR WINDOW "NOWBAT W077 deliberately nonexistent window" TIMEOUT 0
IF %RESULT% NE 1 THEN GOTO ERROR
IF %WINW% NE 65535 THEN GOTO ERROR
WINDOWSELECT "NOWBAT W071 deliberately nonexistent window"
IF %RESULT% NE 1 THEN GOTO ERROR
IF %WINW% NE 65535 THEN GOTO ERROR
MOUSEMOVE REL,10,10
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
LOGFILE "C:\WASUAT\WINMISS.OK"
LOG "MISSING=@RUN@ %MOUSEX%,%MOUSEY%"
LOGCLOSE
LOGFILE "C:\WASUAT\WINPASS.OK"
LOG "WINDOW_PASS=@RUN@"
LOGCLOSE
END
:ERROR
SET FAILR=%RESULT%
SET FAILE=%ERRORCODE%
LOGFILE "C:\WASUAT\WINFAIL.LOG"
LOG "WINDOW_FAIL=@RUN@ RESULT=%FAILR% ERRORCODE=%FAILE% X=%WINX% Y=%WINY% W=%WINW% H=%WINH%"
LOGCLOSE
FAIL
