; NOWBAT STARTSHOT: keep DOSBox-X visible and open a window manually.
; Test WAIT, full-desktop default FAST capture, SNAPSAFE crop, and TAR.
; The launcher replaces C:\WASUAT and @RUN@ with a fresh private guest path/token.
; The runtime is headless by default: show an actual minimized WIN icon.
SHOWICON=YES
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOGFILE "C:\WASUAT\SHOTBEG.OK"
LOG "SHOT_BEGIN=@RUN@"
LOGCLOSE
WAIT 10000
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOGFILE "C:\WASUAT\SHOTWAT.OK"
LOG "SHOT_WAIT_DONE=@RUN@"
LOGCLOSE
LOGFILE "C:\WASUAT\TIMES.LOG"
LOG "SNAPSAFE_START=%DATE% %TIME%"
; Small GDI crop verifies the explicit safe command remains functional.
SNAPSAFE "C:\WASUAT\SAFE.BMP",0,0,63,31,BPP=1
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOG "SNAPSAFE_END=%DATE% %TIME%"
LOG "COMPAT_CROP_OK=YES"
; The full-screen test intentionally omits BPP, coordinates and MODE.
LOG "SNAPFAST_START=%DATE% %TIME%"
SNAP "C:\WASUAT\SCREEN.BMP"
IF %RESULT% EQ 2 THEN GOTO SHOT_UNSUPPORTED
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOG "SNAPFAST_END=%DATE% %TIME%"
LOGCLOSE
LOGFILE "C:\WASUAT\SNAPOK.OK"
LOG "SNAP_DONE=@RUN@"
LOGCLOSE
TARCREATE "C:\WASUAT\SCREEN.TAR"
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOGFILE "C:\WASUAT\TARCRT.OK"
LOG "TAR_CREATED=@RUN@"
LOGCLOSE
TARADD "C:\WASUAT\SCREEN.BMP"
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOGFILE "C:\WASUAT\TARBMP.OK"
LOG "TAR_BMP_ADDED=@RUN@"
LOGCLOSE
; SHOT.WAS is a separate copy, not the executing TEST.WAS handle.
TARADD "SHOT.WAS"
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOGFILE "C:\WASUAT\TARSCR.OK"
LOG "TAR_SCRIPT_ADDED=@RUN@"
LOGCLOSE
TARCLOSE
IF %RESULT% NE 0 THEN GOTO SHOT_FAIL
LOGFILE "C:\WASUAT\TAROK.OK"
LOG "TAR_DONE=@RUN@"
LOGCLOSE
; Capture-only diagnostic: EXIT APPLICATION, DO NOT SHUT DOWN WINDOWS.
; Host closes DOSBox after authentic END + TAROK, not after a Windows dialog.
END
:SHOT_UNSUPPORTED
; Unsupported FAST must not launch a multi-minute COMPAT fallback.
LOG "SNAPFAST_END=%DATE% %TIME%"
LOG "FAST_UNSUPPORTED=YES"
LOGCLOSE
LOGFILE "C:\WASUAT\FASTNO.OK"
LOG "FAST_UNSUPPORTED=@RUN@"
LOGCLOSE
END
:SHOT_FAIL
LOGFILE "C:\WASUAT\SHOTERR.LOG"
LOG "STARTSHOT_FAILED=@RUN@ RESULT=%RESULT%"
LOGCLOSE
END
