# WAS native guest audit: these commands run INSIDE Windows, never on host.
# Every file is staged in C:\WASUAT by HOST\runuat.py.
LOGFILE "C:\WASUAT\WAS.LOG"
LOG "WAS_UAT_BEGIN"
SET TEST=HELLO
IF %TEST% EQ IMPOSSIBLE THEN GOTO FAILED
IF %TEST% NE HELLO THEN GOTO FAILED
IF %TEST% EQ HELLO THEN GOTO VARSOK
GOTO FAILED
:VARSOK
LOG "VARS_OK"
CHDIR "C:\WASUAT"
SHELLWAIT "C:\WASUAT\RC.COM" "OK"
IF %ERRORCODE% NE 7 GOTO FAILED
IF %RESULT% NE 0 GOTO FAILED
LOG "SHELLWAIT_OK"
GOSUB SUBTEST
IF %RESULT% NE 0 GOTO FAILED
SNAPSAFE "C:\WASUAT\FULL.BMP"
IF %RESULT% NE 0 GOTO FAILED
SNAPSAFE "C:\WASUAT\R1.BMP",0,0,15,15,1
IF %RESULT% NE 0 GOTO FAILED
SNAPSAFE "C:\WASUAT\R4.BMP",0,0,15,15,4
IF %RESULT% NE 0 GOTO FAILED
SNAPSAFE "C:\WASUAT\R8.BMP",0,0,15,15,8
IF %RESULT% NE 0 GOTO FAILED
SNAPSAFE "C:\WASUAT\R24.BMP",0,0,15,15,24
IF %RESULT% NE 0 GOTO FAILED
GOSUB COLLECT
IF %RESULT% NE 0 GOTO FAILED
PASS
:SUBTEST
LOG "SUB_OK"
RETURN
:COLLECT
TARCREATE "C:\WASUAT\RESULT.TAR"
LOG "WAS_UAT_PASS"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\WAS.LOG"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\FULL.BMP"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\R1.BMP"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\R4.BMP"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\R8.BMP"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\R24.BMP"
IF %RESULT% NE 0 GOTO FAILED
TARADD "C:\WASUAT\*.TXT"
IF %RESULT% NE 0 GOTO FAILED
TARCLOSE
IF %RESULT% NE 0 GOTO FAILED
RETURN
:FAILED
LOG "WAS_UAT_FAIL"
FAIL
