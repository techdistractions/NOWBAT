; Real keyboard dispatch; independent WGEOM WndProc records native messages.
SHOWICON=NO
LOGFILE "C:\WASUAT\KEYBOARD.LOG"
SET STAGE=START
SHELL "WGEOM.EXE"
IF %RESULT% NE 0 THEN GOTO ERROR
WAITFOR FILE "WGEOM.DAT" TIMEOUT 15000
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=FOCUS
WINDOWFOCUS "NOWBAT Geometry Fixture"
IF %RESULT% NE 0 THEN GOTO ERROR
MOUSEMOVE REL,12,12
IF %RESULT% NE 0 THEN GOTO ERROR
MOUSECLICK LEFT
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 500
SET STAGE=KEYPRESS
KEYPRESS A
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=SHIFT_DOWN
KEYDOWN SHIFT
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=SHIFT_B
KEYPRESS B
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=RELEASE
RELEASEINPUT
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=KEYPRESS_C
KEYPRESS C
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=CTRL_DOWN
KEYDOWN CTRL
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=HELD_COMPOSITE
KEYCOMBO SHIFT+X
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
TYPE "x"
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
SET STAGE=CTRL_UP
KEYUP CTRL
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=INVALID
KEYUP CTRL
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
KEYPRESS INVALID
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
SET STAGE=CHORD_INVALID
KEYCOMBO CTRL+CTRL+X
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
KEYCOMBO CTRL+
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
KEYCOMBO A+X
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
TYPE "unterminated
IF %RESULT% NE 2 THEN GOTO ERROR
IF %ERRORCODE% NE 87 THEN GOTO ERROR
TYPE ""
IF %RESULT% NE 0 THEN GOTO ERROR
SET STAGE=CHORD_SHIFT
KEYCOMBO SHIFT+D
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=CHORD_CTRL_SHIFT
KEYCOMBO CTRL+SHIFT+F2
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=TYPE
TYPE "Ab 19!?."
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 200
SET STAGE=TYPE_RECOVERY
KEYPRESS Z
IF %RESULT% NE 0 THEN GOTO ERROR
WAIT 500
LOG "Native keyboard commands completed"
LOGCLOSE
LOGFILE "C:\WASUAT\KBPASS.OK"
LOG "KEYBOARD_PASS=@RUN@"
LOGCLOSE
END
:ERROR
SET FAILR=%RESULT%
SET FAILE=%ERRORCODE%
RELEASEINPUT
LOG "KEYBOARD FAIL stage=%STAGE% result=%FAILR% error=%FAILE%"
LOGCLOSE
LOGFILE "C:\WASUAT\KBFAIL.LOG"
LOG "KEYBOARD_FAIL=@RUN@ STAGE=%STAGE% RESULT=%FAILR% ERRORCODE=%FAILE%"
LOGCLOSE
FAIL
