FORMAT WINDOWS
OPTION STACK=2048
NAME DIST/WIN300/NOWBAT.EXE
FILE BUILD/WAS300.OBJ,BUILD/WASTAR.OBJ,BUILD/WASSNAP.OBJ,BUILD/WASFS.OBJ,BUILD/WASUI.OBJ
IMPORT InitTask KERNEL.91
IMPORT WaitEvent KERNEL.30
IMPORT InitApp USER.5
IMPORT GetVersion KERNEL.3
IMPORT GetWinFlags KERNEL.132
IMPORT Yield KERNEL.29
IMPORT SetTimer USER.10
IMPORT KillTimer USER.12
IMPORT WaitMessage USER.112
IMPORT LoadModule KERNEL.45
IMPORT GetModuleUsage KERNEL.48
IMPORT GetDC USER.66
IMPORT ReleaseDC USER.68
IMPORT GetDeviceCaps GDI.80
IMPORT GetPixel GDI.83
IMPORT ExitWindows USER.7
IMPORT RegisterClass USER.57
IMPORT CreateWindow USER.41
IMPORT ShowWindow USER.42
IMPORT DestroyWindow USER.53
IMPORT GetSystemMenu USER.156
IMPORT ChangeMenu USER.153
IMPORT DefWindowProc USER.107
IMPORT PeekMessage USER.109
IMPORT DispatchMessage USER.114
IMPORT MessageBox USER.1
IMPORT LoadIcon USER.174
